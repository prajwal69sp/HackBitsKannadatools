{
  "name": "hackbitskannada-admin",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["web"],
  "scripts": {
    "dev": "npm run dev --workspace hackbitskannada-web",
    "build": "npm run build --workspace hackbitskannada-web",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "tsx --test tests/api.integration.test.ts",
    "test:integration": "start-server-and-test start http://127.0.0.1:3000/login test:api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@aws-sdk/client-s3": "^3.879.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "prismjs": "^1.30.0",
    "react-simple-code-editor": "^0.14.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.1.5",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^6.16.2",
    "start-server-and-test": "^2.0.13",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript-eslint": "^8.71.0",
    "@types/prismjs": "^1.26.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
